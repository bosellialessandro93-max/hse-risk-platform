# For Neon/PostgreSQL use secrets.neon.toml.example instead.
# Copy into Community Cloud -> App -> Settings -> Secrets. Never commit real values.
[database]
host = "mysql.example.net"
port = 3306
name = "hse_streamlit"
user = "hse_application"
password = "REPLACE_WITH_DATABASE_PASSWORD"
prefix = "st_"
tls = true
# ca_certificate = """-----BEGIN CERTIFICATE-----
# YOUR_PROVIDER_CA
# -----END CERTIFICATE-----"""

[hse_auth]
mode = "password"
bootstrap_username = "administrator"
bootstrap_password = "REPLACE_WITH_RANDOM_PASSWORD_AT_LEAST_12_CHARACTERS"

# Alternative: mode = "oidc" above; verified email claim required.
# admin_emails = ["admin@your-company.example"]
# allowed_domains = ["your-company.example"]
# [auth]
# redirect_uri = "https://YOUR-APP.streamlit.app/oauth2callback"
# cookie_secret = "REPLACE_WITH_RANDOM_64_CHARACTER_SECRET"
# client_id = "YOUR_OIDC_CLIENT_ID"
# client_secret = "YOUR_OIDC_CLIENT_SECRET"
# server_metadata_url = "https://YOUR-PROVIDER/.well-known/openid-configuration"

# client_kwargs = { scope = "openid email profile" }
