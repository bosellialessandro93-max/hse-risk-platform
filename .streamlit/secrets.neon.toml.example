# Streamlit Community Cloud -> App settings -> Secrets.
# Neon -> Connect: choose the dedicated hse_streamlit database and copy Connection string.
# Paste only postgresql://... (not psql, shell quotes or a terminal command).
[database]
url = "postgresql://USER:PASSWORD@YOUR-ENDPOINT.neon.tech/hse_streamlit?sslmode=require&channel_binding=require"
prefix = "st_"

[hse_auth]
mode = "password"
bootstrap_username = "administrator"
bootstrap_password = "REPLACE_WITH_RANDOM_PASSWORD_AT_LEAST_12_CHARACTERS"
